grid-of-greed/
├── index.html                  # point d'entrée unique (salon + table)
├── package.json                # "type": "module", script "test"
├── README.md
│
├── docs/
│   ├── instructions.md         # contraintes pour devs / IA (comme dans FTM)
│   ├── brief.md                # idée, nom, ton, public
│   ├── rules.md                # tes règles + décisions sur les cas limites
│   └── design.md               # palette, cartes, plateau 3×3, placements 2 à 8
│
├── src/
│   ├── main.js                 # démarrage : branche réseau, contrôleur, UI
│   │
│   ├── engine/                 # règles pures, sans DOM ni réseau
│   │   └── engine.js           # (déjà écrit)
│   │
│   ├── controller/
│   │   ├── hostController.js   # l'hôte : reçoit les actions, appelle dispatch,
│   │   │                       #   diffuse la vue masquée à chacun
│   │   └── clientController.js # le joueur : envoie ses actions, reçoit sa vue
│   │
│   ├── net/
│   │   ├── adapter.js          # l'interface : join, send, onMessage, peers
│   │   ├── trysteroAdapter.js  # l'implémentation réelle (WebRTC)
│   │   └── localAdapter.js     # faux réseau en mémoire, pour tests et bots
│   │
│   ├── ui/
│   │   ├── seating.js          # placement 2 à 8 + échelle (logique pure)
│   │   ├── table.js            # plateau 3×3
│   │   ├── card.js             # composant carte (dos, face, retournement)
│   │   ├── lobby.js            # créer / rejoindre en deux clics
│   │   ├── scoreboard.js
│   │   ├── journal.js          # « Eli est greedy ! »
│   │   └── roundEnd.js         # décompte de fin de manche
│   │
│   └── styles/
│       ├── tokens.css          # couleurs, tailles, rayons
│       ├── cards.css
│       ├── table.css
│       └── lobby.css
│
├── tests/
│   ├── engine.test.js          # (déjà écrit)
│   ├── seating.test.js
│   └── host.test.js            # une partie entière via localAdapter
│
└── assets/                     # favicon, éventuels sons