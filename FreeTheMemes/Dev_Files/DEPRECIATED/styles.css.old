:root {
  color-scheme: dark;
  --ink: #f0efe7;
  --paper: #252b27;
  --muted: #a4ada4;
  --background: #111613;
  --surface: #1a211d;
  --surface-raised: #242d27;
  --line: #39453c;
  --hotpink: #e98065;
  --purple: #86b5a0;
  --acid: #d5e36c;
  --orange: #e99a59;
  --cyan: #78c5bd;
  --danger: #e47670;
  --piece-0: #d5e36c; --piece-1: #e99a59; --piece-2: #78c5bd; --piece-3: #c2a878;
  --piece-4: #e47670; --piece-5: #83bd8b; --piece-6: #d7c168; --piece-7: #d78b9b;
  font-family: "Segoe UI", "Aptos", sans-serif;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  min-width: 320px;
  color: var(--ink);
  background:
    linear-gradient(135deg, rgba(213, 227, 108, .035) 25%, transparent 25%) 0 0 / 28px 28px,
    var(--background);
}
button { font: inherit; }
button:focus-visible { outline: 2px solid var(--acid); outline-offset: 2px; }
.app-shell { width: min(1480px, 100%); margin: 0 auto; padding: 32px; }

/* ---------- Lobby / welcome ---------- */
.welcome {
  min-height: calc(100vh - 56px); display: grid; align-content: center; justify-items: start; max-width: 720px;
  padding: 40px; background: var(--surface); border: 1px solid var(--line); border-radius: 4px;
}
.welcome .action { margin-top: 28px; min-width: 210px; }
.lobby-actions { display: grid; gap: 10px; width: min(420px, 100%); margin-top: 28px; }
.lobby-actions .action { margin-top: 0; }
.name-field { display: grid; gap: 6px; color: var(--ink); font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.name-field input { padding: 11px 12px; color: var(--ink); background: var(--surface-raised); border: 1px solid var(--line); border-radius: 3px; font: inherit; letter-spacing: normal; text-transform: none; }
.room-join { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
.room-join input { min-width: 0; padding: 10px 12px; color: var(--ink); background: var(--surface-raised); border: 1px solid var(--line); border-radius: 3px; }
.room-status { min-height: 20px; margin-top: 14px; color: var(--muted); font-size: 12px; font-weight: 600; }

/* ---------- Header ---------- */
.topbar { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding-bottom: 22px; }
.eyebrow { margin: 0 0 8px; color: var(--acid); font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
h1, h2, h3, p { margin-top: 0; }
h1 {
  margin-bottom: 12px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.4rem, 6vw, 5.4rem);
  line-height: .98; color: var(--ink); font-weight: 500;
}
h1 span { color: var(--acid); }
.subtitle { max-width: 560px; margin-bottom: 0; color: var(--muted); font-size: 15px; line-height: 1.55; font-weight: 400; }
.status { display: flex; align-items: center; gap: 9px; padding: 7px 10px; color: var(--ink); background: var(--surface-raised); border: 1px solid var(--line); border-radius: 3px; font-size: 11px; font-weight: 700; letter-spacing: .04em; white-space: nowrap; }
.status-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--ink); }

/* ---------- Layout & panels ---------- */
.layout { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 22px; padding-top: 22px; }
.panel {
  position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; color: var(--ink);
}
.board-panel {
  min-height: 650px; padding: 24px;
  background: linear-gradient(155deg, #1d2620, #171d19 70%);
}
.victory-banner { padding: 18px; margin-bottom: 20px; background: #33372a; border-left: 3px solid var(--acid); border-radius: 2px; }
.victory-banner h2 { margin: 0 0 6px; font-family: Georgia, "Times New Roman", serif; font-size: 28px; font-weight: 500; }
.victory-banner p:not(.eyebrow) { margin-bottom: 7px; color: var(--ink); font-size: 22px; font-weight: 700; }
.victory-banner small { color: var(--muted); font-weight: 600; }
.panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 18px; }
.panel-head h2 { margin-bottom: 0; font-family: Georgia, "Times New Roman", serif; font-size: 21px; font-weight: 500; }
.phase { padding: 5px 8px; color: var(--acid); background: #30372c; border: 1px solid #4a5540; border-radius: 2px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }

/* ---------- Six-area board ---------- */
.board-ring { position: relative; width: 100%; max-width: 640px; aspect-ratio: 1; margin: 0 auto 10px; }
.board-ring::before { content: ""; position: absolute; inset: 30%; border: 1px solid #465247; border-radius: 50%; opacity: .75; }
.zone {
  position: absolute; width: 28%; min-width: 150px;
  padding: 12px; background: #252e28; border: 1px solid #435046; border-top: 2px solid var(--pair-color, var(--acid)); border-radius: 3px;
}
.zone:nth-child(1) { top: 12.9%; left: 35%; transform: translate(-50%, -50%); --pair-color: var(--cyan); }
.zone:nth-child(2) { top: 12.9%; left: 65%; transform: translate(-50%, -50%); --pair-color: var(--cyan); }
.zone:nth-child(3) { top: 55.6%; left: 89.6%; transform: translate(-50%, -50%); --pair-color: var(--orange); }
.zone:nth-child(4) { top: 81.5%; left: 74.6%; transform: translate(-50%, -50%); --pair-color: var(--orange); }
.zone:nth-child(5) { top: 81.5%; left: 25.4%; transform: translate(-50%, -50%); --pair-color: var(--hotpink); }
.zone:nth-child(6) { top: 55.6%; left: 10.4%; transform: translate(-50%, -50%); --pair-color: var(--hotpink); }
.zone.you-are-here { outline: 2px solid var(--acid); outline-offset: 2px; }
.zone-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.zone-icon { font-size: 21px; line-height: 1; }
.zone-title h3 { margin: 0; color: var(--ink); font-size: 13px; line-height: 1.25; font-weight: 650; }
.zone-position { color: var(--muted); font-size: 10px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
.zone-tokens { display: flex; flex-wrap: wrap; gap: 6px; min-height: 30px; }
.empty { color: var(--muted); font-size: 12px; font-weight: 400; }

.piece { display: inline-flex; align-items: center; gap: 5px; padding: 3px 7px 3px 3px; background: #303a33; border: 1px solid #4a574e; border-radius: 3px; }
.piece-avatar { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--piece-color, var(--acid)); color: #171b17; font-size: 11px; font-weight: 800; }
.piece-name { color: var(--ink); font-size: 11px; font-weight: 600; }
.piece.current { background: #46402b; border-color: var(--orange); }
.piece.dead { opacity: .5; }
.piece.dead .piece-name { text-decoration: line-through; }
.piece-0 { --piece-color: var(--piece-0); } .piece-1 { --piece-color: var(--piece-1); }
.piece-2 { --piece-color: var(--piece-2); } .piece-3 { --piece-color: var(--piece-3); }
.piece-4 { --piece-color: var(--piece-4); } .piece-5 { --piece-color: var(--piece-5); }
.piece-6 { --piece-color: var(--piece-6); } .piece-7 { --piece-color: var(--piece-7); }

/* ---------- Side column ---------- */
.side { display: grid; align-content: start; gap: 22px; }
.control-panel, .players-panel, .log-panel { padding: 18px; }
.control-panel h2, .players-panel h2, .log-panel h2 { margin-bottom: 15px; }
.control-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

.action {
  min-height: 42px; padding: 10px 12px; color: #171b17; background: var(--acid);
  border: 1px solid var(--acid); border-radius: 3px; cursor: pointer; font-size: 12px; font-weight: 700; text-align: center;
  transition: background-color .12s ease, border-color .12s ease;
}
.action:hover { background: #e3ed98; border-color: #e3ed98; }
.action.secondary { color: var(--ink); background: #303a33; border-color: #536258; }
.action.secondary:hover { background: #3a4a3f; border-color: var(--cyan); }
.action:disabled { cursor: not-allowed; opacity: .45; background: #343a35; border-color: #454b46; color: var(--muted); }
.pending-choices { display: grid; gap: 8px; margin-top: 8px; }
.pending-label { margin: 0; color: var(--ink); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
.current-player { padding: 12px 14px; margin-bottom: 12px; background: #2b352d; border-left: 3px solid var(--acid); border-radius: 2px; color: var(--ink); }
.current-player small { display: block; margin-bottom: 4px; color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: .1em; }
.current-player strong { font-family: Georgia, "Times New Roman", serif; font-size: 19px; font-weight: 500; }

/* ---------- Character cards (trading-card sticker look) ---------- */
.character-cards { display: grid; gap: 12px; }
.char-card { padding: 12px; background: var(--surface-raised); border: 1px solid var(--line); border-left: 3px solid var(--piece-color, var(--line)); border-radius: 3px; }
.char-card.active { outline: 1px solid var(--acid); outline-offset: 1px; }
.char-card.dead { opacity: .5; }
.char-card-head { display: flex; align-items: center; gap: 9px; margin-bottom: 9px; }
.char-avatar { display: grid; place-items: center; width: 30px; height: 30px; flex: none; border-radius: 50%; background: var(--piece-color, var(--line)); color: #171b17; font-weight: 800; }
.char-card-identity { display: grid; line-height: 1.25; }
.char-card-identity strong { font-size: 13px; }
.char-card-identity small { color: var(--muted); font-size: 11px; font-weight: 600; }
.char-card.faction-user .char-card-identity small { color: #78c5bd; }
.char-card.faction-memer .char-card-identity small { color: #e99a59; }
.char-card.faction-troller .char-card-identity small { color: #e47670; }
.hp-bar { height: 8px; background: #151a17; border: 1px solid #48534a; border-radius: 2px; overflow: hidden; }
.hp-fill { height: 100%; background: var(--acid); }
.hp-bar.hp-hidden .hp-fill { background: repeating-linear-gradient(45deg, var(--muted), var(--muted) 4px, transparent 4px, transparent 8px); }
.char-meta { margin: 6px 0 0; color: var(--muted); font-size: 11px; font-weight: 500; }
.equip-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
.equip-chip { padding: 3px 7px; color: var(--ink); background: #343d36; border: 1px solid #4a554d; border-radius: 2px; font-size: 10px; font-weight: 600; text-transform: capitalize; }

.log { display: grid; gap: 8px; max-height: 270px; overflow: auto; padding-right: 5px; }
.log-line { color: var(--muted); font-size: 12px; font-weight: 400; line-height: 1.45; }
.log-line strong { color: var(--ink); }

@media (max-width: 960px) { .layout { grid-template-columns: 1fr; } .side { grid-template-columns: 1fr 1fr; } .log-panel { grid-column: 1 / -1; } }
@media (max-width: 720px) {
  .board-ring { max-width: none; aspect-ratio: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .board-ring::before { display: none; }
  .zone { position: static; width: auto; min-width: 0; transform: none !important; }
}
@media (max-width: 620px) { .app-shell { padding: 18px; } .topbar { align-items: start; flex-direction: column; } .layout, .side { display: block; } .side > * { margin-top: 18px; } .welcome { padding: 22px; } }

/* ---------- Online-first screens ---------- */
#app.app-shell { width: 100%; max-width: none; min-height: 100svh; padding: 0; }
.home-screen, .room-screen, .game-screen { color: var(--ink); }
.wordmark { color: var(--ink); font-size: 12px; font-weight: 800; letter-spacing: .12em; text-decoration: none; }
.home-screen, .room-screen {
  min-height: 100svh; padding: 0 6vw;
  background:
    radial-gradient(ellipse at 16% 88%, rgba(120, 197, 189, .09), transparent 34rem),
    repeating-linear-gradient(135deg, rgba(240, 239, 231, .018) 0 1px, transparent 1px 34px),
    var(--background);
}
.home-screen { display: grid; grid-template-rows: 74px minmax(0, 1fr) 62px; }
.home-topbar, .room-topbar, .game-topbar { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
.home-topbar > span { color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: .14em; }
.home-content { width: min(1160px, 100%); margin: auto; display: grid; grid-template-columns: 1.25fr .75fr; align-items: center; gap: 9%; padding: 70px 0; }
.home-copy { max-width: 650px; }
.home-copy .eyebrow, .room-main .eyebrow { color: var(--cyan); }
.home-copy h1, .room-main h1 { margin: 22px 0; color: var(--ink); font-family: Georgia, "Times New Roman", serif; font-size: 64px; font-weight: 400; line-height: 1.02; }
.home-copy h1 em { color: var(--acid); font-weight: 400; }
.home-intro, .room-intro { max-width: 420px; color: var(--muted); font-size: 16px; line-height: 1.65; }
.name-field { max-width: 360px; margin-top: 34px; color: var(--muted); font-size: 10px; letter-spacing: .1em; }
.name-field input, .room-join input { min-height: 46px; border: 1px solid #4a574e; border-radius: 2px; background: #202823; color: var(--ink); font-size: 14px; }
.online-actions { display: grid; gap: 30px; padding-left: 34px; border-left: 1px solid var(--line); }
.create-room-action { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 66px; padding: 0 20px; border-radius: 2px; font-size: 15px; }
.create-room-action span:last-child { font-size: 21px; }
.join-room-block > label, .invite-block > label { display: block; margin-bottom: 9px; color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: .12em; }
.room-join { grid-template-columns: minmax(0, 1fr) auto; gap: 7px; }
.room-join .action { min-height: 46px; }
.home-screen .room-status { margin: 0; color: var(--muted); }
.home-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); color: #768078; font-size: 9px; font-weight: 700; letter-spacing: .1em; }

.room-screen { display: grid; grid-template-rows: 74px 1fr; }
.room-topbar { gap: 20px; }
.connection-state { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: .1em; }
.connection-state i { width: 7px; height: 7px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 12px rgba(213, 227, 108, .3); }
.room-content { width: min(1080px, 100%); margin: auto; display: grid; grid-template-columns: 1.3fr .7fr; align-items: center; gap: 10%; padding: 64px 0; }
.room-main h1 { margin: 18px 0 12px; }
.room-intro { margin-bottom: 32px; }
.invite-block { max-width: 550px; padding: 18px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.invite-field { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
.invite-field input { min-width: 0; padding: 10px; border: 1px solid var(--line); border-radius: 2px; background: #141a16; color: var(--ink); font: 12px "Segoe UI", sans-serif; }
.invite-field .action { min-width: 76px; }
.room-code { display: inline-block; margin-top: 12px; color: var(--acid); font-size: 11px; }
.start-room-action { display: flex; justify-content: space-between; align-items: center; width: min(320px, 100%); margin-top: 24px; padding: 12px 16px; }
.start-room-action span { font-size: 18px; }
.waiting-note { display: flex; align-items: center; gap: 10px; margin: 26px 0 0; color: var(--muted); font-size: 13px; }
.waiting-pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); animation: waiting-pulse 1.5s ease-in-out infinite; }
@keyframes waiting-pulse { 50% { opacity: .3; } }
.room-main .room-status { margin-top: 18px; color: var(--muted); }
.room-roster { padding-left: 28px; border-left: 1px solid var(--line); }
.roster-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
.roster-heading h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 22px; font-weight: 400; }
.roster-heading > span, .roster-foot { color: var(--muted); font-size: 10px; }
.room-roster ul { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
.room-player { display: grid; grid-template-columns: 32px 1fr auto; align-items: center; gap: 10px; min-height: 55px; border-bottom: 1px solid #303a33; font-size: 13px; }
.room-player small { color: var(--cyan); font-size: 9px; font-weight: 700; letter-spacing: .08em; }
.room-player-mark { display: grid; place-items: center; width: 28px; aspect-ratio: 1; background: #343e36; color: var(--acid); font-size: 12px; }
.room-player-open { color: #788178; }
.room-player-open .room-player-mark { background: transparent; border: 1px dashed #4a574e; color: #788178; }
.room-player-waiting { color: var(--muted); }
.roster-foot { margin-top: 14px; }

.game-screen { height: 100svh; min-height: 620px; overflow: hidden; display: grid; grid-template-rows: 56px minmax(0, 1fr) auto 76px; gap: 10px; padding: 0 28px 12px; background: var(--background); }
.game-topbar { gap: 20px; }
.game-session-label { display: flex; align-items: center; gap: 16px; }
.game-room-code { color: var(--muted); font: 10px monospace; }
.game-topbar .phase { margin-left: auto; }
.game-screen .board-panel { min-height: 0; padding: 4px 0; display: grid; grid-template-rows: auto minmax(0, 1fr); justify-items: center; align-items: center; overflow: hidden; background: transparent; border: 0; }
.game-screen .panel-head { width: min(620px, 100%); margin: 0; }
.game-screen .panel-head h2 { color: var(--muted); font-family: "Segoe UI", sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.game-screen .board-ring { width: min(520px, 100%, 59vh); max-width: none; max-height: 100%; margin: 0 auto; }
.game-screen .board-ring::before { inset: 30%; border-color: #344139; border-style: solid; }
.game-screen .zone { width: 30%; min-width: 0; min-height: 94px; padding: 10px; background: #202823; }
.game-screen .zone:nth-child(1) { top: 12.9%; left: 35%; }
.game-screen .zone:nth-child(2) { top: 12.9%; left: 65%; }
.game-screen .zone:nth-child(3) { top: 55.6%; left: 89.6%; }
.game-screen .zone:nth-child(4) { top: 81.5%; left: 74.6%; }
.game-screen .zone:nth-child(5) { top: 81.5%; left: 25.4%; }
.game-screen .zone:nth-child(6) { top: 55.6%; left: 10.4%; }
.game-screen .zone-head { gap: 7px; margin-bottom: 8px; }
.game-screen .zone-icon { font-size: 18px; }
.game-screen .zone-title h3 { font-size: 12px; }
.players-strip { min-width: 0; border-top: 1px solid var(--line); padding-top: 8px; }
.players-strip-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 7px; }
.players-strip-head h2 { margin: 0; color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.players-strip-head > span { color: #768078; font-size: 9px; letter-spacing: .08em; }
.game-screen .character-cards { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.game-screen .char-card { padding: 8px 10px; background: #1d2520; }
.game-screen .char-card-head { margin-bottom: 6px; }
.game-screen .char-avatar { width: 26px; height: 26px; }
.game-screen .char-card-identity strong { font-size: 12px; }
.game-screen .char-card-identity small, .game-screen .char-meta { font-size: 10px; }
.game-screen .equip-row { margin-top: 5px; }
.game-screen .equip-chip { font-size: 9px; }
.game-toolbar { position: relative; display: grid; grid-template-columns: minmax(150px, 1fr) auto auto; align-items: center; gap: 16px; border-top: 1px solid var(--line); }
.turn-summary { display: grid; gap: 3px; }
.turn-summary small { color: var(--muted); font-size: 10px; }
.turn-summary strong { font-family: Georgia, "Times New Roman", serif; font-size: 17px; font-weight: 400; }
.game-actions { display: flex; gap: 8px; }
.game-actions .action { min-width: 142px; }
.toolbar-extras { display: flex; gap: 14px; }
.toolbar-extras details { position: relative; }
.toolbar-extras summary { color: var(--muted); cursor: pointer; font-size: 11px; }
.attack-menu > div, .event-log .log { position: absolute; z-index: 4; right: 0; bottom: 28px; width: 260px; max-height: 260px; overflow: auto; padding: 10px; border: 1px solid var(--line); background: #1b231e; }
.attack-menu > div { display: grid; gap: 6px; }
.event-log .log { display: grid; gap: 8px; width: 340px; }
.game-toolbar .pending-choices { position: absolute; z-index: 5; right: 0; bottom: 68px; display: flex; flex-wrap: wrap; align-items: center; gap: 7px; max-width: min(680px, 100%); padding: 12px; border: 1px solid #56654f; border-radius: 2px; background: #202823; }
.game-toolbar .pending-label { width: 100%; color: var(--ink); }
.game-toolbar .pending-choices .action { min-height: 36px; }
.game-screen .victory-banner { justify-self: stretch; width: min(520px, 100%); margin: 0 auto; }
.turn-banner {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: fit-content; margin: 0 auto 16px; padding: 8px 18px;
  background: var(--surface-raised); border: 1px solid var(--line); border-radius: 999px;
  color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
}
.turn-banner-you { border-color: var(--acid); color: var(--ink); }
.turn-banner-name {
  color: var(--acid); font-family: Georgia, "Times New Roman", serif;
  font-size: 14px; font-weight: 500; letter-spacing: normal; text-transform: none;
}

.turn-modal-overlay {
  position: fixed; inset: 0; z-index: 50;
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
  background: rgba(10, 14, 11, .65);
  animation: modal-fade-in .18s ease;
}
.turn-modal {
  width: min(380px, 100%); padding: 24px;
  background: var(--surface); border: 1px solid var(--line); border-radius: 6px;
  box-shadow: 0 24px 64px rgba(0, 0, 0, .45);
  animation: modal-pop-in .24s cubic-bezier(.22, .9, .32, 1.26);
}
.turn-modal-title {
  margin: 0 0 16px; text-align: center;
  font-family: Georgia, "Times New Roman", serif; font-size: 19px; font-weight: 500; color: var(--ink);
}
.turn-modal-actions { display: grid; gap: 8px; }
.modal-action { min-height: 46px; }

@keyframes modal-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes modal-pop-in {
  from { opacity: 0; transform: scale(.9) translateY(10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .turn-modal-overlay, .turn-modal { animation: none; }
}
@media (max-width: 760px) {
  .home-screen, .room-screen { padding: 0 22px; }
  .home-content, .room-content { grid-template-columns: 1fr; gap: 36px; padding: 42px 0; }
  .home-copy h1, .room-main h1 { font-size: 46px; }
  .online-actions, .room-roster { padding: 0; border: 0; }
  .home-footer { font-size: 8px; }
  .game-screen { height: auto; min-height: 100svh; overflow: visible; grid-template-rows: 52px minmax(410px, 1fr) auto auto; gap: 12px; padding: 0 14px 14px; }
  .game-screen .board-panel { min-height: 410px; }
  .game-screen .board-ring { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(100px, auto); width: 100%; aspect-ratio: auto; }
  .game-screen .board-ring::before { display: none; }
  .game-screen .zone { position: static; width: auto; min-width: 0; min-height: 0; transform: none; }
  .game-screen .character-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .game-toolbar { grid-template-columns: 1fr; gap: 10px; padding-top: 10px; }
  .game-actions { width: 100%; }
  .game-actions .action { flex: 1; min-width: 0; }
  .toolbar-extras { justify-content: flex-end; }
  .game-toolbar .pending-choices { position: static; grid-column: 1; }
}

@media (max-width: 420px) {
  .home-screen, .room-screen { padding: 0 16px; }
  .home-content, .room-content { padding: 32px 0; }
  .home-copy h1, .room-main h1 { font-size: 40px; }
  .home-footer { align-items: flex-start; flex-direction: column; justify-content: center; gap: 5px; }
  .room-topbar .connection-state { font-size: 8px; }
}

